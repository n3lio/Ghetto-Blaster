{
  "name": "ghetto-blaster",
  "version": "3.17.20",
  "description": "Personal music player & LAN streamer for Windows, by n3lio",
  "main": "main.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "main.js",
    "preload.js",
    "server-module.js",
    "config.json",
    "lib/**/*",
    "public/**/*",
    "assets/**/*"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dev:server": "node scripts/dev-server.js",
    "scan": "node scripts/scan.js",
    "build:frontend": "node scripts/build-frontend.js",
    "watch:frontend": "node scripts/build-frontend.js --watch",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "test": "node --test tests/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{js,json,md,yml}\""
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "electron-updater": "^6.1.7",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "music-metadata": "^7.14.0",
    "qrcode": "^1.5.3",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "electron": "^31.7.0",
    "electron-builder": "^24.9.1",
    "esbuild": "^0.23.0",
    "eslint": "^9.10.0",
    "globals": "^15.9.0",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0"
  },
  "build": {
    "appId": "com.n3lio.ghettoblaster",
    "productName": "Ghetto Blaster",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "server-module.js",
      "config.json",
      "lib/**/*",
      "public/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.music",
      "darkModeSupport": true
    },
    "dmg": {
      "title": "Ghetto Blaster ${version}",
      "iconSize": 100,
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "icon": "assets/icon.png",
      "category": "Audio",
      "synopsis": "Personal music player & LAN streamer",
      "desktop": {
        "Name": "Ghetto Blaster",
        "Comment": "Personal music player & LAN streamer",
        "Categories": "Audio;Player;AudioVideo;"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true
    },
    "publish": {
      "provider": "github",
      "owner": "n3lio",
      "repo": "Ghetto-Blaster"
    }
  }
}
